#ifndef SECRETS_H
#define SECRETS_H

// ============================================================
//  本地私密配置模板  ——  vision-node（XIAO ESP32-S3 Sense 视觉节点）
// ============================================================
//
//  用法：
//    1. 把本文件复制成同目录下的 secrets.h
//         cp secrets.h.example secrets.h
//    2. 填上你自己的 WiFi 和 RK3568 的地址
//    3. secrets.h 已写进 .gitignore，不会被提交
//
//  宏名带 _CFG 后缀是故意的：
//  .ino 里已经有同名的 static 变量（WIFI_SSID / FUSION_URL），
//  宏名不加后缀会被预处理器就地展开，直接把代码搞成语法错误。
//
// ============================================================


// ------------------------------------------------------------
//  WiFi —— 必须和 RK3568 在同一个局域网
// ------------------------------------------------------------
#define WIFI_SSID_CFG       "your-wifi-ssid"
#define WIFI_PASSWORD_CFG   "your-wifi-password"


// ------------------------------------------------------------
//  RK3568 水果融合服务地址
//  对应板端 8099 端口的 POST /api/vision-fusion
//  把 IP 换成你板子的实际地址（板子上 ip addr 查）
// ------------------------------------------------------------
#define FUSION_URL_CFG      "http://192.168.43.44/api/vision-fusion"


#endif  // SECRETS_H
