/*
 * MimiClaw Build-time Secrets
 *
 * Copy this file to mimi_secrets.h and fill in your values.
 *   cp mimi_secrets.h.example mimi_secrets.h
 *
 * ── 配置优先级（2026-10 更正）──────────────────────────────
 *   本文件 **不是** 唯一的配置途径，它是 fallback。WiFi 凭据的实际顺序是：
 *     1) NVS  —— 串口 CLI:  set_wifi <ssid> <pass>   （写入后立即生效，重启保留）
 *     2) 本文件（编译期宏）
 *   但下面这几项 **只能在编译期设置**，CLI 改不了，改了必须重编重烧：
 *     MIMI_SECRET_STATIC_IP / MIMI_SECRET_STATIC_GATEWAY / MIMI_SECRET_STORE_URL
 * ──────────────────────────────────────────────────────────
 */

#pragma once

/* WiFi
 * ⚠️ ESP32-S3 只有 2.4 GHz 射频。热点必须开在 2.4 GHz，
 *    开在 5 GHz 时表现为反复 Disconnected(reason=201:NO_AP_FOUND)，
 *    且连 "state: init -> auth" 都不会出现 —— 与凭据对错无关。 */
#define MIMI_SECRET_WIFI_SSID       ""
#define MIMI_SECRET_WIFI_PASS       ""

/* 静态 IP —— 留空则走 DHCP。
 * ⚠️ 门店部署时不要留空：这个地址是被硬依赖的 ——
 *      主控 firmware/store-controller/Inventory_Monitor.cpp、Voice_Interaction.cpp 的 MINICLAW_IP
 *      网页 ws://<ip>:18789/    告警入口 http://<ip>:18791/alert
 *    换网段时请保留「固定 IP」设计、只改网段，不要改成 DHCP。 */
#define MIMI_SECRET_STATIC_IP       ""
#define MIMI_SECRET_STATIC_GATEWAY  ""
/* 掩码可选；不定义时 mimi_config.h 兜底为 255.255.255.0 */
/* #define MIMI_SECRET_STATIC_NETMASK  "255.255.255.0" */

/* Telegram Bot */
#define MIMI_SECRET_TG_TOKEN        ""

/* Feishu Bot */
#define MIMI_SECRET_FEISHU_APP_ID   ""
#define MIMI_SECRET_FEISHU_APP_SECRET ""

/* Anthropic API */
#define MIMI_SECRET_API_KEY         ""
#define MIMI_SECRET_MODEL           ""
#define MIMI_SECRET_MODEL_PROVIDER  "anthropic"

/* HTTP Proxy (leave empty or set both) */
#define MIMI_SECRET_PROXY_HOST      ""
#define MIMI_SECRET_PROXY_PORT      ""
#define MIMI_SECRET_PROXY_TYPE      ""   /* "http" or "socks5" */

/* Brave Search API */
#define MIMI_SECRET_SEARCH_KEY      ""
/* Tavily Search API */
#define MIMI_SECRET_TAVILY_KEY      ""

/* 门店 store 服务基地址（read-only integration）
 * ⚠️ 必须带端口：RK3568 的 store 服务监听 8094，80 端口上没有服务。
 *    漏端口的表现是每隔 2 秒刷一次 "Connection reset by peer"。 */
#define MIMI_SECRET_STORE_URL       "http://192.168.1.100:8094"
