#ifndef SECRETS_H
#define SECRETS_H

// ============================================================
//  本地私密配置模板  ——  store-controller（ESP32-S3 外设从机）
// ============================================================
//
//  角色说明（2026-10 迁移后）：
//    这块 ESP32-S3 已从「门店主控」降级为「硬实时外设从机」。
//    主控职责（商品/订单/收银/会员/网页/库存）由 RK3568 接管。
//    本机只保留：HX711 称重、I2S 语音、WS2812、DHT22、RFID、USB 扫码枪，
//    并把数据上报给 RK3568。
//    （Work7_20.ino 里的 SLAVE_MODE = 0 可以切回原来的主控形态）
//
//  用法：
//    1. 把本文件复制成同目录下的 secrets.h
//         cp secrets.h.example secrets.h
//    2. 打开 secrets.h，把下面的占位值换成你自己的真实值
//    3. secrets.h 已写进 .gitignore，永远不会被提交
//
//  ⚠️ 不要往这个模板文件（secrets.h.example）里填真实密钥。
//     也不要直接改代码里的字面量 —— 那是上一个踩过的坑。
//
// ============================================================


// ------------------------------------------------------------
//  RK3568（新主控）的地址
// ------------------------------------------------------------
// 从机会把称重/RFID/条码上报到这台机器，并接收它下发的 TTS 播报指令。
// 端口在 Slave_Config.h 里定义（融合 8099 / 收银 8094 / 扫码枪 8095）。
#define RK_HOST              "192.168.43.44"


// ------------------------------------------------------------
//  WiFi
// ------------------------------------------------------------
// 门店路由器：主控以 STA 模式接入，用于连外网 + 连内网各服务
#define WIFI_STA_SSID        "your-wifi-ssid"
#define WIFI_STA_PASSWORD    "your-wifi-password"

// 主控自己开的热点（现场调试时手机直连用）
#define WIFI_AP_SSID         "WIFI_Test"
#define WIFI_AP_PASSWORD     "12345678"


// ------------------------------------------------------------
//  阿里云百炼 DashScope（通义千问，语音问答用）
//  控制台：https://bailian.console.aliyun.com/  →  API-KEY
// ------------------------------------------------------------
#define DASHSCOPE_API_KEY    "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"


// ------------------------------------------------------------
//  百度智能云 —— 语音识别 / 语音合成
//  控制台：https://console.bce.baidu.com/ai/  →  语音技术  →  应用列表
// ------------------------------------------------------------
#define BAIDU_API_KEY        "your-baidu-api-key"
#define BAIDU_SECRET_KEY     "your-baidu-secret-key"


// ------------------------------------------------------------
//  聚合数据 —— 天气查询
//  文档：https://www.juhe.cn/docs/api/id/73
// ------------------------------------------------------------
#define JUHE_WEATHER_KEY     "your-juhe-weather-key"


// ------------------------------------------------------------
//  内网服务地址（按你现场的实际网段改）
// ------------------------------------------------------------
// 树莓派 Flask 服务器（老方案遗留，RK3568 接管后基本不用了）
#define PI_URL               "http://192.168.43.33:5000"

// MimiClaw 人工服务告警回调地址
#define MIMICLAW_ALERT_URL   "http://192.168.43.100:18791/alert"

// 管理类接口的鉴权头 X-MimiClaw-Key 取值。
// 换一个别人猜不到的字符串；RK3568 那边要填一样的值。
#define MIMICLAW_STORE_KEY   "change-me-store-key"


#endif  // SECRETS_H
