#ifndef SECRETS_H
#define SECRETS_H

/* ============================================================
 *  本地私密配置模板  ——  thermal-printer（ESP32-S3 热敏打印机）
 * ============================================================
 *
 *  用法：
 *    1. 把本文件复制成同目录下的 secrets.h
 *         cp secrets.h.example secrets.h
 *    2. 填上你自己的 WiFi 和主控地址
 *    3. secrets.h 已写进 .gitignore，不会被提交
 *
 *  注意：main.c 用 #include "secrets.h" 引它，
 *        引号形式会优先在 main.c 所在目录查找，所以放在 main/ 下即可。
 * ============================================================ */

/* WiFi —— 必须和主控 ESP32-S3 / RK3568 在同一局域网 */
#define WIFI_SSID               "your-wifi-ssid"
#define WIFI_PASSWORD           "your-wifi-password"

/* 主控（或 RK3568 接管后的 store 服务）的基地址，不要带结尾斜杠 */
#define CONTROLLER_BASE_URL     "http://192.168.43.44"

#endif /* SECRETS_H */
