[Unit]
Description=RK3568 fruit detection service, 8-class model (8089)
Documentation=file:///home/linaro/ai/fruit-fusion/README.md
# 本文件**取代**旧版的 rk3568-fruit.service。
# 旧版只用 `--port 8089`，走的是 fruit_service.py 里硬编码的
# 3 类默认值（apple/carrot/orange）和旧模型 fruits_yolo11s_i8.rknn。
# 换成 8 类水果模型**不需要改 fruit_service.py 一行代码** ——
# 它本来就支持 --model / --classes，改这里就行。
After=network.target rk3568-vision.service
Wants=rk3568-vision.service

[Service]
Type=simple
# 必须用 linaro 跑：rknnlite 装在那个账号的 user site-packages 里，
# 用 root 会 ModuleNotFoundError。
User=linaro
Group=video
WorkingDirectory=/home/linaro/ai/fruit
# --classes 的顺序**必须**与训练时 data.yaml 的 names 下标顺序一致，
# 否则类别会串位。这 8 个名字同时必须与 fruit_rules.json 的 label 逐字相同
# （校验：python3 05_check_labels.py --classes /home/linaro/ai/models/fruit8_yolo11n.classes.txt）
# 注意 grape 写的是 grapes —— 原工程 VISION_WEIGHT_RULES 的 label 就是 grapes。
ExecStart=/usr/bin/python3 /home/linaro/ai/fruit/fruit_service.py \
    --port 8089 \
    --model /home/linaro/ai/models/fruit8_yolo11n_i8.rknn \
    --classes apple,banana,orange,grapes,pear,strawberry,kiwi,watermelon
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rk3568-fruit

[Install]
WantedBy=multi-user.target
